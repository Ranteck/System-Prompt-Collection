    bt_loop_duration: 10\n    default_server_timeout: 20\n    wait_for_service_timeout: 1000\n    action_server_result_timeout: 900.0\n    navigators: [\"navigate_to_pose\", \"navigate_through_poses\"]\n    navigate_to_pose:\n      plugin: \"nav2_bt_navigator::NavigateToPoseNavigator\"\n    navigate_through_poses:\n      plugin: \"nav2_bt_navigator::NavigateThroughPosesNavigator\"\n    error_code_names:\n      - compute_path_error_code\n      - follow_path_error_code\n\ncontroller_server:\n  ros__parameters:\n    use_sim_time: true\n    controller_frequency: 15.0\n    costmap_update_timeout: 0.30\n    min_x_velocity_threshold: 0.01\n    min_y_velocity_threshold: 0.001\n    min_theta_velocity_threshold: 0.05\n    failure_tolerance: 0.8\n    progress_checker_plugins: [\"progress_checker\"]\n    goal_checker_plugins: [\"general_goal_checker\"]\n    controller_plugins: [\"FollowPath\"]\n    use_realtime_priority: false\n\n    # Progress checker\n    progress_checker:\n      plugin: \"nav2_controller::SimpleProgressChecker\"\n      required_movement_radius: 0.2\n      movement_time_allowance: 30.0\n\n    # Goal checker - Relaxed for quadruped\n    general_goal_checker:\n      plugin: \"nav2_controller::SimpleGoalChecker\"\n      xy_goal_tolerance: 0.35      # 35cm tolerance for smoother final approach\n      yaw_goal_tolerance: 0.45     # ~26 degrees\n      stateful: true\n\n    # Controller - DWB for quadruped\n    FollowPath:\n      plugin: \"dwb_core::DWBLocalPlanner\"\n      debug_trajectory_details: false\n      min_vel_x: 0.0                # Avoid local-planner reverse dithering\n      min_vel_y: 0.0                # No lateral movement for quadruped\n      max_vel_x: 0.22               # Softer for stable turning near walls\n      max_vel_y: 0.0                # No lateral movement\n      max_vel_theta: 0.35           # Reduce tipping risk in sharp corrections\n      min_speed_xy: 0.03            # Allow near-stop while rotating to re-orient\n      max_speed_xy: 0.22\n      min_speed_theta: 0.02\n      acc_lim_x: 0.25\n      acc_lim_y: 0.0\n      acc_lim_theta: 0.6\n      decel_lim_x: -0.30\n      decel_lim_y: 0.0\n      decel_lim_theta: -0.6\n      vx_samples: 12\n      vy_samples: 1                 # Only 1 since no lateral movement\n      vtheta_samples: 16\n      sim_time: 1.2\n      linear_granularity: 0.04\n      angular_granularity: 0.025\n      transform_tolerance: 0.2\n      xy_goal_tolerance: 0.35\n      trans_stopped_velocity: 0.05\n      short_circuit_trajectory_evaluation: true\n      stateful: true\n      critics: [\"PreferForward\", \"RotateToGoal\", \"Oscillation\", \"BaseObstacle\", \"GoalAlign\", \"PathAlign\", \"PathDist\", \"GoalDist\"]\n      PreferForward.scale: 8.0\n      BaseObstacle.scale: 0.20\n      PathAlign.scale: 20.0\n      PathAlign.forward_point_distance: 0.1\n      GoalAlign.scale: 14.0\n      GoalAlign.forward_point_distance: 0.1\n      PathDist.scale: 20.0\n      GoalDist.scale: 16.0\n      RotateToGoal.scale: 18.0\n      RotateToGoal.slowing_factor: 8.0\n      RotateToGoal.lookahead_time: -1.0\n\nlocal_costmap:\n  local_costmap:\n    ros__parameters:\n      use_sim_time: true\n      update_frequency: 8.0\n      publish_frequency: 2.0\n      global_frame: odom\n      robot_base_frame: base_link\n      rolling_window: true\n      width: 4\n      height: 4\n      resolution: 0.05\n      footprint: \"[[0.36, 0.17], [0.36, -0.17], [-0.36, -0.17], [-0.36, 0.17]]\"  # Go2 EDU ~70x32cm with small margin\n      plugins: [\"obstacle_layer\", \"inflation_layer\"]\n      inflation_layer:\n        plugin: \"nav2_costmap_2d::InflationLayer\"\n        cost_scaling_factor: 4.0\n        inflation_radius: 0.35\n      obstacle_layer:\n        plugin: \"nav2_costmap_2d::ObstacleLayer\"\n        enabled: true\n        observation_sources: scan\n        scan:\n          topic: /scan\n          max_obstacle_height: 2.0\n          clearing: true\n          marking: true\n          data_type: \"LaserScan\"\n          raytrace_max_range: 3.0\n          raytrace_min_range: 0.0\n          obstacle_max_range: 2.5\n          obstacle_min_range: 0.0\n      always_send_full_costmap: true\n\nglobal_costmap:\n  global_costmap:\n    ros__parameters:\n      use_sim_time: true\n      update_frequency: 1.0\n      publish_frequency: 1.0\n      global_frame: map\n      robot_base_frame: base_link\n      footprint: \"[[0.36, 0.17], [0.36, -0.17], [-0.36, -0.17], [-0.36, 0.17]]\"  # Go2 EDU ~70x32cm with small margin\n      resolution: 0.05\n      track_unknown_space: true\n      plugins: [\"static_layer\", \"obstacle_layer\", \"inflation_layer\"]\n      obstacle_layer:\n        plugin: \"nav2_costmap_2d::ObstacleLayer\"\n        enabled: true\n        observation_sources: scan\n        scan:\n          topic: /scan\n          max_obstacle_height: 2.0\n          clearing: true\n          marking: true\n          data_type: \"LaserScan\"\n          raytrace_max_range: 3.0\n          raytrace_min_range: 0.0\n          obstacle_max_range: 2.5\n          obstacle_min_range: 0.0\n      static_layer:\n        plugin: \"nav2_costmap_2d::StaticLayer\"\n        map_subscribe_transient_local: true\n      inflation_layer:\n        plugin: \"nav2_costmap_2d::InflationLayer\"\n        # Keep margin but avoid over-penalizing short valid routes.\n        cost_scaling_factor: 3.2\n        inflation_radius: 0.40\n      always_send_full_costmap: true\n\nplanner_server:\n  ros__parameters:\n    use_sim_time: true\n    expected_planner_frequency: 20.0\n    planner_plugins: [\"GridBased\"]\n    GridBased:\n      plugin: \"nav2_navfn_planner::NavfnPlanner\"\n      tolerance: 0.25\n      use_astar: true\n      allow_unknown: false\n\nsmoother_server:\n  ros__parameters:\n    use_sim_time: true\n    smoother_plugins: [\"simple_smoother\"]\n    simple_smoother:\n      plugin: \"nav2_smoother::SimpleSmoother\"\n      tolerance: 1.0e-10\n      max_its: 1000\n      do_refinement: true\n\nbehavior_server:\n  ros__parameters:\n    use_sim_time: true\n    costmap_topic: local_costmap/costmap_raw\n    footprint_topic: local_costmap/published_footprint\n    cycle_frequency: 10.0\n    behavior_plugins: [\"spin\", \"backup\", \"drive_on_heading\", \"assisted_teleop\", \"wait\"]\n    spin:\n      plugin: \"nav2_behaviors::Spin\"\n    backup:\n      plugin: \"nav2_behaviors::BackUp\"\n    drive_on_heading:\n      plugin: \"nav2_behaviors::DriveOnHeading\"\n    wait:\n      plugin: \"nav2_behaviors::Wait\"\n    assisted_teleop:\n      plugin: \"nav2_behaviors::AssistedTeleop\"\n    global_frame: odom\n    robot_base_frame: base_link\n    transform_tolerance: 0.1\n    simulate_ahead_time: 2.0\n    max_rotational_vel: 0.5\n    min_rotational_vel: 0.1\n    rotational_acc_lim: 1.0\n\nwaypoint_follower:\n  ros__parameters:\n    use_sim_time: true\n    loop_rate: 20\n    stop_on_failure: false\n    action_server_result_timeout: 900.0\n    waypoint_task_executor_plugin: \"wait_at_waypoint\"\n    wait_at_waypoint:\n      plugin: \"nav2_waypoint_follower::WaitAtWaypoint\"\n      enabled: true\n      waypoint_pause_duration: 3000  # 3 seconds to scan ArUco marker\n\nvelocity_smoother:\n  ros__parameters:\n    use_sim_time: true\n    smoothing_frequency: 25.0\n    scale_velocities: false\n    feedback: \"OPEN_LOOP\"\n    max_velocity: [0.22, 0.0, 0.35]\n    min_velocity: [-0.10, 0.0, -0.50]\n    max_accel: [0.25, 0.0, 0.60]\n    max_decel: [-0.30, 0.0, -0.60]\n    odom_topic: \"/odom/filtered\"\n    odom_duration: 0.1\n    deadband_velocity: [0.02, 0.0, 0.02]\n    velocity_timeout: 1.0\n\ncollision_monitor:\n  ros__parameters:\n    use_sim_time: true\n    base_frame_id: \"base_link\"\n    odom_frame_id: \"odom\"\n    cmd_vel_in_topic: \"cmd_vel_smoothed\"\n    cmd_vel_out_topic: \"cmd_vel\"\n    state_topic: \"collision_monitor_state\"\n    transform_tolerance: 0.2\n    source_timeout: 1.0\n    base_shift_correction: true\n    stop_pub_timeout: 2.0\n    polygons: [\"FootprintApproach\"]\n    FootprintApproach:\n      type: \"polygon\"\n      action_type: \"approach\"\n      footprint_topic: \"/local_costmap/published_footprint\"\n      time_before_collision: 0.6\n      simulation_time_step: 0.1\n      min_points: 10\n      visualize: false\n      enabled: true\n    observation_sources: [\"scan\"]\n    scan:\n      type: \"scan\"\n      topic: \"scan\"\n      min_height: 0.05\n      max_height: 2.0\n      enabled: true\n","numLines":305,"startLine":1,"totalLines":305}},"sourceToolAssistantUUID":"afced01e-6fdc-4f7e-83eb-fd8e50265bde"}
